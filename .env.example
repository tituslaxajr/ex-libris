# Database — a local SQLite file by default. For production, use a Turso URL
# (libsql://...) plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/exlibris.db
# DATABASE_AUTH_TOKEN=

# AI provider: "anthropic" (default) or "mock" (deterministic canned responses,
# no key needed). With no ANTHROPIC_API_KEY set, the app automatically falls
# back to showing AI features as disabled — everything else still works.
# AI_PROVIDER=anthropic

# Your Anthropic API key — create one at https://console.anthropic.com
# The key is only ever read on the server; it never reaches the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# Models (optional). Chat = the reading companion; task = background jobs
# like enrichment, classification, and nudges.
# AI_CHAT_MODEL=claude-opus-4-8
# AI_TASK_MODEL=claude-haiku-4-5-20251001

# Optional: raises Google Books lookup quota (works keyless for personal use)
# GOOGLE_BOOKS_API_KEY=

# Optional passcode lock. Leave unset and the app is fully open (default). Set
# it and the app requires this passcode at /unlock before anything else loads.
# APP_PASSCODE=

# Optional: where uploaded EPUB/PDF files are stored (defaults to data/uploads).
# UPLOAD_DIR=

# --- Self-hosting (Docker / Fly.io / VPS) ---------------------------------
# When running the container, point both at the mounted volume so your
# database and uploaded books persist across redeploys. docker-compose.yml and
# fly.toml already set these; include them here if you run the image directly.
# DATABASE_URL=file:/data/exlibris.db
# UPLOAD_DIR=/data/uploads
